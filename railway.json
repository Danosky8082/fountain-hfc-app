{
  "build": {
    "builder": "NIXPACKS",
    "nixPkgs": ["nodejs", "openssl"],
    "buildCommand": "npm install --legacy-peer-deps && npx prisma generate"
  },
  "deploy": {
    "startCommand": "node index.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}